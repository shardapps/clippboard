<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="clr-namespace:Clippboard.App.Design">
    <SolidColorBrush x:Key="Chrome" Color="#F5FFFFFF"/><SolidColorBrush x:Key="NoteSurface" Color="White"/>
    <SolidColorBrush x:Key="Foreground" Color="#273146"/><SolidColorBrush x:Key="Muted" Color="#69758A"/>
    <SolidColorBrush x:Key="Outline" Color="#DDE3ED"/><SolidColorBrush x:Key="Accent" Color="#526DCC"/>
    <SolidColorBrush x:Key="SelectedSurface" Color="#E9EEFF"/><SolidColorBrush x:Key="StarColor" Color="#A47313"/>
    <Style TargetType="Button">
      <Setter Property="d:Interaction.Enhance" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="Surface" Background="Transparent">
          <Border x:Name="Base" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11"/>
          <Border x:Name="HoverSurface" Background="{DynamicResource SelectedSurface}" CornerRadius="11" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          <Border x:Name="FocusOutline" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Foreground}"/></Style>
    <Style TargetType="ToolTip">
      <Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource Chrome}"/><Setter Property="Foreground" Value="{DynamicResource Foreground}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" MaxWidth="340"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="d:Interaction.Enhance" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/><Setter Property="Background" Value="{DynamicResource NoteSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Border x:Name="Rail" Width="3" Background="{DynamicResource Outline}" CornerRadius="2" HorizontalAlignment="Center" Margin="4"/><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource Accent}" Opacity="0.6" Margin="3" CornerRadius="6"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
        </Track></Grid>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="Rail" Property="Width" Value="Auto"/><Setter TargetName="Rail" Property="Height" Value="3"/><Setter TargetName="Rail" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="Rail" Property="VerticalAlignment" Value="Center"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="d:Interaction.Enhance" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Switch" Width="34" Height="20" Background="{DynamicResource Outline}" CornerRadius="10" HorizontalAlignment="Left"><Border x:Name="Knob" Background="White" Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Left" Margin="3"><Border.RenderTransform><TranslateTransform x:Name="KnobMotion"/></Border.RenderTransform></Border></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="Focus" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent" Height="28" Margin="6,0"><Border Height="5" CornerRadius="2.5" Background="{DynamicResource Outline}"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="2.5" Background="{DynamicResource Accent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="24" Height="24" d:Interaction.Enhance="True"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Fill="{DynamicResource SelectedSurface}"/><Ellipse Margin="4" Fill="{DynamicResource NoteSurface}" Stroke="{DynamicResource Accent}" StrokeThickness="2"/><Ellipse Margin="9" Fill="{DynamicResource Accent}"/><Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </ResourceDictionary>
