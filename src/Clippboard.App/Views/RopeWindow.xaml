<Window x:Class="Clippboard.App.Views.RopeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="clr-namespace:Clippboard.App.Design" Title="Clippboard" WindowStyle="None" AllowsTransparency="True" Background="#01000000" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" PreviewKeyDown="OnKeyDown" PreviewMouseWheel="OnMouseWheel" MouseDown="OnOutsideClick" Deactivated="OnDeactivated" FontFamily="Segoe UI">
  <Grid x:Name="Scene">
    <Grid x:Name="Panel" VerticalAlignment="Top">
      <Grid.RenderTransform><TranslateTransform x:Name="Slide" Y="-600"/></Grid.RenderTransform>
      <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="72"/><RowDefinition Height="390"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="Toolbar" Margin="12,4" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="20" Padding="9,5" MouseDown="OnInsideClick">
        <WrapPanel HorizontalAlignment="Center">
          <Button ToolTip="Clippboard · Open settings" Click="OnSettings" AutomationProperties.Name="Clippboard settings"><Button.Content><d:IconView Symbol="logo" Width="26" Height="26"/></Button.Content></Button>
          <Border Width="1" Background="{DynamicResource Outline}" Margin="7,7"/>
          <Button x:Name="AllButton" Content="All clips" Click="OnAll"/>
          <Button x:Name="StarredButton" Content="Starred" Click="OnStarred"/>
          <Grid Width="170" Margin="8,0">
            <TextBox x:Name="SearchBox" MaxLength="100" TextChanged="OnSearchChanged" FontSize="13" Padding="10,8" ToolTip="Search saved previews · Ctrl + F" AutomationProperties.Name="Search saved previews"/>
            <TextBlock Text="Search previews…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
          <Button x:Name="TypeFilterButton" Content="All types" ToolTip="Filter by text, images or files" Click="OnTypeFilter"/>
          <Button x:Name="PauseButton" ToolTip="Pause capture" Click="OnPause" AutomationProperties.Name="Pause capture"><d:IconView Symbol="pause"/></Button>
          <Button ToolTip="Settings" Click="OnSettings" AutomationProperties.Name="Settings"><d:IconView Symbol="settings"/></Button>
          <Button ToolTip="Help &amp; feedback" Click="OnFeedback" AutomationProperties.Name="Help and feedback"><d:IconView Symbol="feedback"/></Button>
          <Button ToolTip="Tuck away · Esc" Click="OnClose" AutomationProperties.Name="Retract rope"><d:IconView Symbol="up"/></Button>
        </WrapPanel>
      </Border>
      <Grid Grid.Row="1" x:Name="Board" SizeChanged="OnBoardSizeChanged">
        <d:RopeVisual x:Name="Rope" Height="100" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <ScrollViewer x:Name="NoteScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="OnScrollChanged" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
          <Canvas x:Name="Notes" Height="390"><Canvas.RenderTransform><TranslateTransform x:Name="NotesMotion"/></Canvas.RenderTransform></Canvas>
        </ScrollViewer>
        <Border x:Name="EmptyState" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="22" Width="360" Height="160" VerticalAlignment="Top" Margin="0,70,0,0" MouseDown="OnInsideClick">
          <StackPanel VerticalAlignment="Center" Margin="24"><TextBlock x:Name="EmptyTitle" Text="Room for your next idea." FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Copy something. We'll hang it here." Foreground="{DynamicResource Muted}" TextAlignment="Center" FontSize="15" Margin="0,12,0,0"/></StackPanel>
        </Border>
      </Grid>
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" MouseDown="OnInsideClick">
        <Border x:Name="Navigation" Background="{DynamicResource Chrome}" CornerRadius="17" BorderBrush="{DynamicResource Outline}" BorderThickness="1" Padding="4">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button ToolTip="Previous notes" Click="OnPrevious" AutomationProperties.Name="Scroll left"><d:IconView Symbol="left" Width="18" Height="18"/></Button>
            <ScrollBar x:Name="HistoryScroll" Width="190" Height="16" Orientation="Horizontal" VerticalAlignment="Center" ValueChanged="OnScrollbarChanged" SmallChange="100" ToolTip="Drag to browse clipboard history" AutomationProperties.Name="Browse clipboard history"/>
            <Button ToolTip="Next notes" Click="OnNext" AutomationProperties.Name="Scroll right"><d:IconView Symbol="right" Width="18" Height="18"/></Button>
          </StackPanel>
        </Border>
        <Border x:Name="StatusBubble" Background="{DynamicResource Chrome}" CornerRadius="12" Padding="12,6" Margin="0,8,0,0" MaxWidth="650"><TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/></Border>
      </StackPanel>
    </Grid>
    <Border x:Name="SidebarHost" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,18,18" Width="500" MaxHeight="720" Background="{DynamicResource Chrome}" CornerRadius="24" BorderBrush="{DynamicResource Outline}" BorderThickness="1" MouseDown="OnInsideClick"/>
    <Border x:Name="DetailHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Height="540" Background="{DynamicResource NoteSurface}" CornerRadius="24" BorderBrush="{DynamicResource Outline}" BorderThickness="1" MouseDown="OnInsideClick"/>
  </Grid>
</Window>
